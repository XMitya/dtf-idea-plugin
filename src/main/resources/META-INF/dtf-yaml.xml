<idea-plugin>
    <!--
      Loaded only when the YAML plugin is present. Everything that names a YAML class lives behind
      this file, so the plugin still works - on @TaskSchedule alone - when YAML is disabled.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="com.xmitya.ideadtf.config.yaml.DtfTaskConfigYamlIndex"/>
    </extensions>
    <extensions defaultExtensionNs="com.xmitya.ideadtf">
        <taskConfigSource implementation="com.xmitya.ideadtf.config.yaml.YamlTaskConfigSource"/>
    </extensions>
</idea-plugin>
