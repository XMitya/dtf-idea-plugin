<idea-plugin>
    <id>com.xmitya.ideadtf</id>
    <name>Distributed Task Framework (DTF)</name>
    <vendor>xmitya</vendor>

    <description><![CDATA[
        Editor support for the <a href="https://github.com/cherkovskiyandrey/distributed-task-framework">Distributed
        Task Framework</a> (DTF).
        <p>Marks classes implementing <code>com.distributed_task_framework.task.Task</code> with a gutter icon and
        lets you jump from a task to every place where it is scheduled via
        <code>DistributedTaskService.schedule(...)</code>. Works for Java and Kotlin sources.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- language="UAST" dispatches for every language with a UAST plugin, i.e. Java and Kotlin. -->
        <codeInsight.lineMarkerProvider language="UAST"
                                        implementationClass="com.xmitya.ideadtf.marker.DtfTaskLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="UAST"
                                        implementationClass="com.xmitya.ideadtf.marker.DtfScheduleCallLineMarkerProvider"/>
    </extensions>
</idea-plugin>
