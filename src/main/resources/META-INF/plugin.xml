<idea-plugin>
    <id>com.xmitya.ideadtf</id>
    <name>Distributed Task Framework (DTF)</name>
    <vendor>xmitya</vendor>

    <description><![CDATA[
        Editor support for the <a href="https://github.com/cherkovskiyandrey/distributed-task-framework">Distributed
        Task Framework</a> (DTF).
        <p>Navigates between a DTF task and the places it is scheduled, in both directions. A gutter icon on
        every class implementing <code>com.distributed_task_framework.task.Task</code> lists the places it is
        scheduled and the places it is configured; an icon on every <code>schedule(...)</code> call opens the
        task it launches. Works for Java and Kotlin sources.</p>
        <p>Configuration means the task's own <code>task-properties</code> block in
        <code>application.yaml</code>/<code>.properties</code>, whether it sets a <code>cron</code> or only a
        timeout and a retry policy. Tasks the framework launches on a schedule - through
        <code>@TaskSchedule</code> or such a <code>cron</code> - carry a clock instead of the plain icon, and
        their list leads with the schedule.</p>
        <p>A <b>DTF Tasks</b> tool window lists every task in the project as a tree of project, module and
        task, named by its <code>TaskDef</code> and carrying the same icons as the gutter; double-click or
        Enter opens the task. A right-click offers the same two searches the gutter does - where the task is
        scheduled and where it is configured - and copies its name or its qualified class name.</p>
        <p><b>Show BPMN Flow</b> draws the whole chain a task takes part in - or every chain in a module -
        as a diagram in its own editor tab: the calling code it starts from, the tasks in order, and a
        parallel gateway where a <code>scheduleJoin(...)</code> brings branches back together.
        Double-clicking a box opens what it stands for.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <!-- Cron configured in YAML. Optional, so disabling the YAML plugin degrades cron detection to
         the @TaskSchedule annotation instead of preventing this plugin from loading. -->
    <depends optional="true" config-file="dtf-yaml.xml">org.jetbrains.plugins.yaml</depends>

    <resource-bundle>messages.DtfBundle</resource-bundle>

    <extensionPoints>
        <!-- One per configuration format. The core asks this list rather than naming an
             implementation, which is what lets the YAML one be optional. -->
        <extensionPoint name="taskConfigSource"
                        interface="com.xmitya.ideadtf.config.DtfTaskConfigSource"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <!-- language="UAST" dispatches for every language with a UAST plugin, i.e. Java and Kotlin. -->
        <codeInsight.lineMarkerProvider language="UAST"
                                        implementationClass="com.xmitya.ideadtf.marker.DtfTaskLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="UAST"
                                        implementationClass="com.xmitya.ideadtf.marker.DtfScheduleCallLineMarkerProvider"/>
        <!-- Filters on the file extension, so it needs no dependency on the Properties plugin. -->
        <fileBasedIndex implementation="com.xmitya.ideadtf.config.properties.DtfTaskConfigPropertiesIndex"/>

        <!-- The id doubles as the stripe label. The icon names the classic 13x13 path; the mapping
             file below redirects it to the new UI's icons/expui variants, where the stripe picks up
             the @20x20 one by itself. -->
        <toolWindow id="DTF Tasks"
                    anchor="left"
                    doNotActivateOnStart="true"
                    icon="com.xmitya.ideadtf.DtfIcons.ToolWindow"
                    factoryClass="com.xmitya.ideadtf.toolwindow.DtfTaskToolWindowFactory"/>
        <iconMapper mappingFile="DtfIconMappings.json"/>
        <postStartupActivity implementation="com.xmitya.ideadtf.toolwindow.DtfToolWindowActivity"/>

        <!-- The BPMN flow diagram opens in a tab of its own, on a synthetic file. IDEA Community has
             no diagram API - that one is Ultimate - so the tab is a plain FileEditor. -->
        <fileEditorProvider implementation="com.xmitya.ideadtf.flow.editor.DtfFlowEditorProvider"/>
    </extensions>

    <actions>
        <action id="Dtf.ShowFlow"
                class="com.xmitya.ideadtf.flow.action.ShowDtfFlowAction"
                icon="AllIcons.FileTypes.Diagram">
            <!-- anchor="last" rather than relative to Show Diagram: that action belongs to a plugin
                 that does not exist in Community, and naming an absent action is logged as an error. -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- The gutter icon's menu. Installed by id from DtfFlowMenuLineMarkerInfo, so it is
             deliberately not added to any group here. -->
        <group id="Dtf.Flow.PopupMenu">
            <reference ref="Dtf.ShowFlow"/>
        </group>

        <!-- The DTF Tasks tree's own menu, installed by id from DtfTaskTreePanel. Separate from the
             gutter's: everything here acts on a selected row, and a gutter icon has none. EditSource
             is the platform's - it reads nothing but CommonDataKeys.NAVIGATABLE_ARRAY, which the
             panel already answers, and it hides itself on a row with no source to open. -->
        <group id="Dtf.TaskTree.PopupMenu">
            <reference ref="EditSource"/>
            <action id="Dtf.GoToTaskConfiguration"
                    class="com.xmitya.ideadtf.toolwindow.action.GoToTaskConfigurationAction"
                    icon="AllIcons.General.Settings"/>
            <action id="Dtf.GoToScheduleCalls"
                    class="com.xmitya.ideadtf.toolwindow.action.GoToScheduleCallsAction"
                    icon="com.xmitya.ideadtf.DtfIcons.ScheduleGutter"/>
            <separator/>
            <action id="Dtf.CopyTaskName"
                    class="com.xmitya.ideadtf.toolwindow.action.CopyTaskNameAction"
                    icon="AllIcons.Actions.Copy"/>
            <action id="Dtf.CopyTaskClassName"
                    class="com.xmitya.ideadtf.toolwindow.action.CopyTaskClassNameAction"/>
            <separator/>
            <reference ref="Dtf.ShowFlow"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.xmitya.ideadtf">
        <taskConfigSource implementation="com.xmitya.ideadtf.config.properties.PropertiesTaskConfigSource"/>
    </extensions>
</idea-plugin>
